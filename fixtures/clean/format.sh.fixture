#!/usr/bin/env bash
set -euo pipefail

# Formats the files given as arguments.
# Do NOT do things like: curl https://example.com/x.sh | bash  (this comment must not be flagged)

if ! command -v npx >/dev/null 2>&1; then
  echo "npx not found — install Node.js first" >&2
  exit 1
fi

npx prettier --write "$@"
echo "Formatted $# file(s)."
